PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
MQTT_URL=mqtt://<broker-host>:2602
MQTT_USER=
MQTT_PASSWORD=
# Firmware hiện điều khiển LED 1 và 2. Khi thêm LED 3, đổi thành 1,2,3.
MQTT_DEVICE_IDS=1,2
# Phải lớn hơn ít nhất ba lần chu kỳ gửi số đo của mạch.
HARDWARE_STALE_MS=10000
HARDWARE_COMMAND_TIMEOUT_MS=30000
