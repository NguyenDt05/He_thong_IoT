              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const body = pm.response.json();",
                  "pm.test('Hardware status has required fields', () => {",
                  "  pm.expect(body).to.include.all.keys('connected', 'lastSeen', 'staleAfterMs', 'checkedAt');",
                  "  pm.expect(body.connected).to.be.a('boolean');",
                  "  pm.expect(body.lastSeen).to.be.an('object');",
                  "  pm.expect(body.staleAfterMs).to.be.a('number').and.to.be.above(0);",
                  "  pm.expect(Number.isNaN(Date.parse(body.checkedAt))).to.eql(false);",
                  "});",
                  "pm.test('Configured sensor timestamps are ISO or null', () => {",
                  "  ['TEMPERATURE', 'HUMIDITY', 'LIGHT'].forEach((type) => {",
                  "    pm.expect(body.lastSeen).to.have.property(type);",
                  "    pm.expect(body.lastSeen[type] === null || !Number.isNaN(Date.parse(body.lastSeen[type]))).to.eql(true);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
