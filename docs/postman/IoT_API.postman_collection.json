  "item": [
    {
      "name": "DataSensor",
      "description": "GET /api/data-sensor đọc data_sensor JOIN sensors, hỗ trợ tìm kiếm và phân trang.",
      "item": [
        {
          "name": "List sensor data - success",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/data-sensor?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "data-sensor"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Số nguyên dương; mặc định 1, tối đa 100000."
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Số nguyên dương; mặc định 10, tối đa 100."
                },
                {
                  "key": "key",
                  "value": "",
                  "description": "Từ khóa tìm kiếm.",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "TEMPERATURE",
                  "description": "TEMPERATURE, HUMIDITY hoặc LIGHT.",
                  "disabled": true
                },
                {
                  "key": "field",
                  "value": "all",
                  "description": "all, type, datetime hoặc value.",
                  "disabled": true
                }
              ]
            },
            "description": "Trả dữ liệu mới nhất trước. Lỗi DB trả 500 {error: 'Loi'}; không có cách an toàn để kích hoạt lỗi DB từ query."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const body = pm.response.json();",
                  "pm.test('Pagination fields are valid', () => {",
                  "  pm.expect(body).to.be.an('object').that.includes.all.keys('data', 'page', 'limit', 'total', 'totalPages');",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  ['page', 'limit', 'total', 'totalPages'].forEach((key) => pm.expect(body[key], key).to.be.a('number'));",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.limit).to.eql(10);",
                  "  pm.expect(body.totalPages).to.eql(Math.ceil(body.total / body.limit));",
                  "});",
                  "pm.test('Every sensor row has required fields and types', () => {",
                  "  body.data.forEach((row) => {",
                  "    pm.expect(row).to.include.all.keys('dataId', 'sensorId', 'sensorName', 'sensorType', 'unit', 'value', 'createdAt', 'createdAtText');",
                  "    pm.expect(row.dataId).to.be.a('number');",
                  "    pm.expect(row.sensorId).to.be.a('number');",
                  "    pm.expect(row.sensorName).to.be.a('string');",
                  "    pm.expect(row.sensorType).to.be.oneOf(['TEMPERATURE', 'HUMIDITY', 'LIGHT']);",
                  "    pm.expect(row.unit).to.be.a('string');",
                  "    pm.expect(row.value).to.be.a('number');",
                  "    pm.expect(row.createdAt === null || !Number.isNaN(Date.parse(row.createdAt))).to.eql(true);",
                  "    pm.expect(row.createdAtText === null || /^\\d{2}\\/\\d{2}\\/\\d{4} \\d{2}:\\d{2}:\\d{2}$/.test(row.createdAtText)).to.eql(true);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Filter temperature by value - success",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/data-sensor?page=1&limit=20&type=TEMPERATURE&field=value&key=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "data-sensor"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "type", "value": "TEMPERATURE" },
                { "key": "field", "value": "value" },
                { "key": "key", "value": "25" }
              ]
            },
            "description": "Kết quả có thể rỗng; nếu có dòng thì mọi dòng phải là TEMPERATURE và value dạng chuỗi chứa từ khóa 25."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Filtered response keeps pagination schema', () => {",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.limit).to.eql(20);",
                  "});",
                  "pm.test('Rows match type and value filters', () => {",
                  "  body.data.forEach((row) => {",
                  "    pm.expect(row.sensorType).to.eql('TEMPERATURE');",
                  "    pm.expect(String(row.value)).to.include('25');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Invalid pagination is normalized",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/data-sensor?page=0&limit=999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "data-sensor"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "limit", "value": "999" }
              ]
            },
            "description": "Backend không trả 400: page không hợp lệ về 1, limit vượt ngưỡng bị chặn ở 100."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Pagination was normalized', () => {",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.limit).to.eql(100);",
                  "  pm.expect(body.data.length).to.be.at.most(100);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Device",
      "description": "GET /api/devices đọc trạng thái thiết bị và lệnh đang chờ.",
      "item": [
        {
          "name": "List devices - success",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/devices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices"]
            },
            "description": "Không có query/body. Lỗi DB trả 500 {error: 'Không thể tải thiết bị'}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const body = pm.response.json();",
                  "pm.test('Response is an array of valid devices', () => {",
                  "  pm.expect(body).to.be.an('array');",
                  "  body.forEach((row) => {",
                  "    pm.expect(row).to.include.all.keys('deviceId', 'deviceName', 'status', 'pendingActionId', 'controllable', 'updatedAt');",
                  "    pm.expect(row.deviceId).to.be.a('number');",
                  "    pm.expect(row.deviceName).to.be.a('string');",
                  "    pm.expect(row.status).to.be.a('string');",
                  "    pm.expect(row.pendingActionId === null || Number.isInteger(row.pendingActionId)).to.eql(true);",
                  "    pm.expect(row.controllable).to.be.a('boolean');",
                  "    pm.expect(row.updatedAt === null || !Number.isNaN(Date.parse(row.updatedAt))).to.eql(true);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "ActionHistory",
      "description": "GET /api/history đọc lịch sử; POST /api/history tạo lệnh PENDING.",
      "item": [
        {
          "name": "List action history - success",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history"],
              "query": [
                { "key": "page", "value": "1", "description": "Mặc định 1, tối đa 100000." },
                { "key": "limit", "value": "10", "description": "Mặc định 10, tối đa 100." },
                { "key": "key", "value": "LED", "description": "Tìm tên thiết bị/người dùng/action/status/thời gian.", "disabled": true },
                { "key": "device", "value": "DEVICE_1", "description": "Định dạng DEVICE_<id>.", "disabled": true },
                { "key": "action", "value": "ON", "description": "ON hoặc OFF.", "disabled": true },
                { "key": "status", "value": "SUCCESS", "description": "SUCCESS, FAILED hoặc PENDING.", "disabled": true }
              ]
            },
            "description": "Lỗi DB trả 500 {error: 'Không thể tải lịch sử hoạt động'}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const body = pm.response.json();",
                  "pm.test('Pagination fields are valid', () => {",
                  "  pm.expect(body).to.include.all.keys('data', 'page', 'limit', 'total', 'totalPages');",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.limit).to.eql(10);",
                  "  pm.expect(body.totalPages).to.eql(Math.ceil(body.total / body.limit));",
                  "});",
                  "pm.test('Every history row has required fields and types', () => {",
                  "  body.data.forEach((row) => {",
                  "    pm.expect(row).to.include.all.keys('id', 'deviceId', 'deviceName', 'device', 'username', 'action', 'status', 'createdAt', 'time');",
                  "    pm.expect(row.id).to.be.a('number');",
                  "    pm.expect(row.deviceId).to.be.a('number');",
                  "    pm.expect(row.deviceName).to.be.a('string');",
                  "    pm.expect(row.device).to.eql(`DEVICE_${row.deviceId}`);",
                  "    pm.expect(row.username === null || typeof row.username === 'string').to.eql(true);",
                  "    pm.expect(row.action).to.be.oneOf(['ON', 'OFF']);",
                  "    pm.expect(row.status).to.be.oneOf(['SUCCESS', 'FAILED', 'PENDING']);",
                  "    pm.expect(Number.isNaN(Date.parse(row.createdAt))).to.eql(false);",
                  "    pm.expect(row.time).to.match(/^\\d{2}\\/\\d{2}\\/\\d{4} \\d{2}:\\d{2}:\\d{2}$/);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
