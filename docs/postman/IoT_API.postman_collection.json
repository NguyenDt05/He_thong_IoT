        {
          "name": "Create command - success (manual, writes DB)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": {{controlDeviceId}},\n  \"action\": \"{{controlAction}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history"]
            },
            "description": "CÓ GHI CSDL VÀ CÓ THỂ ĐIỀU KHIỂN THIẾT BỊ. Chỉ chạy khi hardware connected, device tồn tại/controllable, không có pendingActionId và runWriteTests=true."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('runWriteTests') !== 'true') {",
                  "  console.warn('Skipped: set collection variable runWriteTests=true to enable the write test.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const row = pm.response.json();",
                  "pm.test('Created command has required pending-history fields', () => {",
                  "  pm.expect(row).to.include.all.keys('id', 'deviceId', 'deviceName', 'device', 'username', 'action', 'status', 'createdAt', 'time');",
                  "  pm.expect(row.id).to.be.a('number');",
                  "  pm.expect(row.deviceId).to.eql(Number(pm.collectionVariables.get('controlDeviceId')));",
                  "  pm.expect(row.device).to.eql(`DEVICE_${row.deviceId}`);",
                  "  pm.expect(row.action).to.eql(pm.collectionVariables.get('controlAction'));",
                  "  pm.expect(row.status).to.eql('PENDING');",
                  "  pm.expect(row.username).to.eql(null);",
                  "  pm.expect(Number.isNaN(Date.parse(row.createdAt))).to.eql(false);",
                  "});"
                ]
              }
            }
